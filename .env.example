# Supabase — NOT used in Phase 0. Reserved for Phase 3 (laptop <-> phone sync).
# Copy this file to .env.local and fill in when Phase 3 lands. Never commit the real .env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional crash reporting (Sentry). Leave blank to disable — the SDK then
# isn't loaded at all. Paste your project DSN to turn it on.
VITE_SENTRY_DSN=
